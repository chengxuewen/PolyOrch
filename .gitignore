# Official reference source clones (git-ignored, script-managed)
.refinfo

# Test and build artifacts
test-results
*.tsbuildinfo

# Python bindings example artifacts

# host multi-process runtime artifacts (host init/start at repo root)
.host/
/etc/
/run/
/recordings/
/identity.json
data/

# example run artifacts (the demo manifests are mechanism, their locks are not committed)
examples/*/pixi.lock
tests/.scratch

# activation scripts installed by examples into workspaces (managed copies)
examples/*/pixi.sh
examples/*/pixi.bat
examples/*/pixi.ps1

# in-source configure accidents (suites always build out-of-tree)
CMakeCache.txt
CMakeFiles/
